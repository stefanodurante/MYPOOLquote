DATABASE_URL=postgresql://postgres:password@host:5432/postgres
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Include http://172.42.*:3000 when the app is served by the vr_npm Docker wrapper.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://172.42.*:3000
STAFF_EMAIL=staff@mypoolquote.local
STAFF_PASSWORD=replace-with-a-development-password
STAFF_NAME=MYPOOL Staff

# Optional Supabase client helpers
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Required by npm run test:supabase against a Supabase test project.
